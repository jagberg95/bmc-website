---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

/** Single source of truth for FAQ content + FAQPage schema */
const faqSections = [
  {
    id: 'general-contracting',
    title: 'General Contracting',
    items: [
      {
        id: 'gc-1',
        question: 'How long does a typical project take?',
        answer:
          'Small repairs: 1–5 days. Larger remodels or additions: 2–6 weeks. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'gc-2',
        question: 'Do you handle insurance work?',
        answer: 'Yes. We work directly with adjusters and ensure proper documentation.',
      },
      {
        id: 'gc-4',
        question: 'Do you pull permits?',
        answer: 'Yes, we handle all permitting and inspections for compliant work.',
      },
      {
        id: 'gc-5',
        question: 'What if my project changes mid-way?',
        answer: 'We document changes in writing and adjust the scope and timeline accordingly.',
      },
      {
        id: 'gc-6',
        question: 'How do you ensure quality across trades?',
        answer: 'We use trusted local partners and supervise all work on site.',
      },
    ],
  },
  {
    id: 'home-renovations',
    title: 'Home Renovations',
    items: [
      {
        id: 'hr-1',
        question: 'How long do renovations typically take?',
        answer:
          'Kitchen or bath projects often take 3–7 weeks depending on scope and material lead times. Whole-home work typically takes 4–12 weeks. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'hr-2',
        question: 'Do you work with older homes?',
        answer:
          'Yes. Many of our projects are in homes built 30–60+ years ago. We’re experienced with the surprises that come with them.',
      },
      {
        id: 'hr-3',
        question: 'Will I need to move out?',
        answer: 'Usually not for kitchen or bath work. We work around your schedule as much as possible.',
      },
      {
        id: 'hr-5',
        question: 'What warranty do you offer?',
        answer:
          'We provide a one-year workmanship warranty, plus manufacturer warranties on materials and appliances.',
      },
    ],
  },
  {
    id: 'kitchen-bath',
    title: 'Kitchen & Bath Remodeling',
    items: [
      {
        id: 'kb-1',
        question: 'How long do kitchen or bath projects take?',
        answer:
          'Typically 3–6 weeks for a standard remodel, depending on scope and material lead times. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'kb-2',
        question: 'Can I live in the home during the work?',
        answer: 'Yes for most projects. We contain dust and work around your schedule.',
      },
      {
        id: 'kb-3',
        question: 'Do you help with design?',
        answer: 'We guide selections and can recommend partners for full design if needed.',
      },
      {
        id: 'kb-7',
        question: 'Can I choose my own materials?',
        answer: 'Yes. We can source or install owner-provided materials with our standard workmanship warranty.',
      },
    ],
  },
  {
    id: 'outdoor-living',
    title: 'Outdoor Living',
    items: [
      {
        id: 'ol-1',
        question: 'How long does an outdoor project take?',
        answer:
          'Most decks and patios are completed in 1–3 weeks depending on size and weather. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'ol-2',
        question: 'What materials hold up well in Texas?',
        answer:
          'We recommend composite decking, treated lumber, and properly sealed concrete for longevity.',
      },
      {
        id: 'ol-3',
        question: 'Do you handle drainage issues?',
        answer: 'Yes. We assess and improve grading and drainage as part of the project.',
      },
      {
        id: 'ol-5',
        question: 'Is a permit needed?',
        answer: 'Often yes for larger structures. We manage the permitting process.',
      },
    ],
  },
  {
    id: 'fencing-repairs',
    title: 'Fencing, Concrete & Repairs',
    items: [
      {
        id: 'fc-1',
        question: 'How long for a fence or patio?',
        answer:
          'Fencing: 3–10 days. Patios/concrete: 2–5 days for most jobs. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'fc-2',
        question: 'Do you do concrete repairs too?',
        answer: 'Yes—cracks, leveling, resurfacing, and full replacement.',
      },
      {
        id: 'fc-4',
        question: 'What fencing materials do you recommend?',
        answer:
          'We offer wood, vinyl, metal, and ranch fencing suited to Texas conditions and aesthetics.',
      },
      {
        id: 'fc-7',
        question: 'Is there a warranty on fencing and concrete?',
        answer: 'Yes, we provide workmanship warranties in addition to manufacturer guarantees.',
      },
    ],
  },
  {
    id: 'custom-homes',
    title: 'Custom Homes',
    items: [
      {
        id: 'ch-1',
        question: 'How long does a custom home take?',
        answer:
          'Typically 9–18 months from start to finish, depending on size, complexity, and material availability. We provide clear, realistic timelines upfront.',
      },
      {
        id: 'ch-2',
        question: 'Can you build on my lot?',
        answer: 'Yes. We evaluate soil, drainage, and access during planning.',
      },
      {
        id: 'ch-3',
        question: 'Do you offer design services?',
        answer: 'We work with your architect or can recommend trusted designers.',
      },
      {
        id: 'ch-7',
        question: 'Do you build energy-efficient homes?',
        answer:
          'Yes. We incorporate insulation, windows, and systems to reduce long-term energy costs.',
      },
    ],
  },
];

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqSections.flatMap((section) =>
    section.items.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    }))
  ),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://barmooncontracting.com/' },
    { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://barmooncontracting.com/faq' },
  ],
};
---

<Layout
  title="Contractor FAQs | Bar Moon Contracting"
  description="Answers on timelines, permits, warranties, and materials for renovations, remodels, custom homes, and repairs in Bell County, TX."
  schemas={[faqPageSchema, breadcrumbSchema]}
>
  <Header />

  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Frequently Asked Questions</h1>
      <p class="text-xl text-gray-700 mb-10 max-w-3xl">
        Answers to common questions about our services, process, and work in Central Texas. Click a
        question in the sidebar to jump to it.
      </p>

      <!-- Mobile FAQ Menu Dropdown -->
      <div class="md:hidden mb-6">
        <label for="faq-jump" class="sr-only">Jump to a section or question</label>
        <select
          id="faq-jump"
          class="w-full p-3 border border-gray-300 rounded-lg bg-white text-sm focus:border-accent focus:ring-1 focus:ring-accent"
          onchange="if (this.value) { if (this.value.startsWith('#')) { window.location.hash = this.value; } else { window.location.href = this.value; } }"
        >
          <option value="">Jump to a section or question...</option>
          {
            faqSections.map((section) => (
              <optgroup label={section.title}>
                {section.items.map((item) => (
                  <option value={`#${item.id}`}>{item.question}</option>
                ))}
              </optgroup>
            ))
          }
          <optgroup label="Blog">
            <option value="/blog">View all articles →</option>
            <option value="/blog/how-to-read-a-contractors-estimate">
              How to Read a Contractor’s Estimate
            </option>
            <option value="/blog/how-to-choose-a-general-contractor">
              How to Choose a General Contractor
            </option>
          </optgroup>
        </select>
      </div>

      <div class="grid md:grid-cols-4 gap-8">
        <!-- Sidebar: All Questions -->
        <aside class="md:col-span-1 hidden md:block">
          <div class="sticky top-24">
            <h2 class="text-lg font-semibold mb-4 text-dark-blue">All Questions</h2>
            <ul class="space-y-2 text-sm">
              {
                faqSections.map((section) => (
                  <li>
                    <details>
                      <summary class="font-medium text-primary mt-3 cursor-pointer hover:text-accent transition">
                        {section.title}
                      </summary>
                      <ul class="mt-1 ml-4 space-y-1 text-sm">
                        {section.items.map((item) => (
                          <li>
                            <a href={`#${item.id}`} class="hover:text-accent transition">
                              {item.question}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  </li>
                ))
              }

              <li>
                <details>
                  <summary class="font-medium text-primary mt-3 cursor-pointer hover:text-accent transition">
                    Blog
                  </summary>
                  <ul class="mt-1 ml-4 space-y-1 text-sm">
                    <li>
                      <a href="/blog" class="hover:text-accent transition">View all articles →</a>
                    </li>
                    <li>
                      <a
                        href="/blog/how-to-read-a-contractors-estimate"
                        class="hover:text-accent transition"
                      >
                        How to Read a Contractor’s Estimate
                      </a>
                    </li>
                    <li>
                      <a
                        href="/blog/how-to-choose-a-general-contractor"
                        class="hover:text-accent transition"
                      >
                        How to Choose a General Contractor
                      </a>
                    </li>
                  </ul>
                </details>
              </li>
            </ul>
          </div>
        </aside>

        <!-- Main Content -->
        <div class="md:col-span-3 space-y-12">
          {
            faqSections.map((section) => (
              <div id={section.id}>
                <h2 class="text-2xl font-bold mb-4 border-b pb-2">{section.title}</h2>
                {section.items.map((item) => (
                  <div id={item.id} class="mb-6">
                    <p>
                      <strong>{item.question}</strong> {item.answer}
                    </p>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-12 p-6 bg-white rounded-2xl border">
        <p class="text-gray-700">
          Still have questions?{' '}
          <a href="/get-quote" class="text-accent hover:underline font-medium">Get in touch</a> or
          call us at{' '}
          <a href="tel:2545813808" class="text-gold-primary">(254) 581-3808</a>. We're happy to help.
        </p>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
