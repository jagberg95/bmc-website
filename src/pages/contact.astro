---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Contact | Bar Moon Contracting"
  description="Contact Bar Moon Contracting in Temple, TX. Call or text (254) 581-3808 Mon–Fri 8 AM–6 PM, or request a free project quote online."
>
  <Header />
  
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-3xl mx-auto px-6 py-16 text-center">
      <h1 class="text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-xl text-gray-700 mb-4">Visit our Contact &amp; Get a Quote page for the full form, details, and how to reach us.</p>
      <a href="/get-quote" class="bg-accent text-dark-blue font-bold px-8 py-3 rounded-lg inline-block">Go to Contact &amp; Get a Quote →</a>
      <p class="mt-6 text-sm text-gray-500">Or call (254) 581-3808 • Mon–Fri 8:00 AM – 6:00 PM</p>
    </div>
  </main>

  <Footer />
</Layout>