---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const url = 'https://barmooncontracting.com/services/general-contracting-nolanville-tx';
const city = 'Nolanville, TX';
const title = 'General Contracting in Nolanville, TX | Bar Moon Contracting';
const description =
  'Nolanville general contractor for repairs, renovations, fencing, painting, and roofing—reliable project management between Temple and Killeen on the I-14 corridor.';

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'General Contracting',
    name: `General Contracting in ${city}`,
    description,
    provider: { '@type': 'GeneralContractor', name: 'Bar Moon Contracting', url: 'https://barmooncontracting.com/' },
    areaServed: [{ '@type': 'City', name: city }, { '@type': 'AdministrativeArea', name: 'Bell County, TX' }],
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://barmooncontracting.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://barmooncontracting.com/services' },
      { '@type': 'ListItem', position: 3, name: `General Contracting in ${city}`, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Do you regularly work in Nolanville?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Nolanville sits squarely in our Bell County service area between Temple and Killeen/Harker Heights.',
        },
      },
      {
        '@type': 'Question',
        name: 'What projects are most common in Nolanville?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Repairs, painting, roofing, fencing, kitchen/bath updates, and outdoor living packages are common—often stacked into one coordinated job.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I get a quote?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Call or text (254) 581-3808 or use the free quote form. We schedule a site visit when needed and provide a written proposal.',
        },
      },
    ],
  },
];
---

<Layout title={title} description={description} schemas={pageSchemas}>
  <Header />
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="mb-8 text-sm text-gray-600">
        <a href="/services" class="text-accent hover:underline">Services</a>
        <span class="mx-2">/</span>
        <span>General Contracting in Nolanville, TX</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-6">General Contracting in Nolanville, TX</h1>
      <p class="text-xl text-gray-700 mb-10">
        Nolanville homeowners sit between Temple and the Killeen–Harker Heights corridor—close enough for busy
        schedules, far enough that you want a contractor who actually shows up when promised. Bar Moon Contracting
        handles repairs, renovations, fencing, roofing, painting, and outdoor projects with straightforward
        communication.
      </p>

      <div class="prose max-w-none text-gray-700 mb-16 space-y-8">
        <h2 class="text-2xl md:text-3xl">Reliable contracting on the I-14 corridor</h2>
        <p>
          Nolanville projects are often practical: fix what is failing, improve a kitchen or bath that no longer
          works for the family, replace a fence, refresh exterior paint, or coordinate a small remodel without
          turning life upside down. We treat those jobs with the same written scope and supervision we use on larger
          Bell County work.
        </p>
        <p>
          Because we already work Temple, Harker Heights, and Killeen regularly, Nolanville scheduling is natural—not
          a special trip we squeeze in “if we can.”
        </p>

        <h2 class="text-2xl md:text-3xl">Services in Nolanville</h2>
        <ul>
          <li>General repairs and maintenance</li>
          <li>Renovations and multi-trade interiors</li>
          <li>Painting, roofing, and exterior upgrades</li>
          <li>Fencing, concrete, and outdoor living</li>
          <li>Storm repairs and insurance documentation support</li>
        </ul>

        <h2 class="text-2xl md:text-3xl">What we plan for locally</h2>
        <p>
          <strong>Heat and storms.</strong> Exterior systems need materials and detailing that survive Central Texas
          weather, not just look good on completion day.
        </p>
        <p>
          <strong>Clay soils.</strong> Fence lines, patio edges, and additions benefit from drainage and attachment
          details that account for soil movement.
        </p>
        <p>
          <strong>Clear communication.</strong> You get a plan, a price structure you can understand, and updates as
          phases complete.
        </p>

        <h2 class="text-2xl md:text-3xl">Our process</h2>
        <ol>
          <li>Call or quote request</li>
          <li>Site assessment when needed</li>
          <li>Written proposal and timeline</li>
          <li>Build with supervised trades</li>
          <li>Walkthrough and closeout</li>
        </ol>

        <h2 class="text-2xl md:text-3xl">Nolanville FAQs</h2>
        <p>
          <strong>Do you regularly work in Nolanville?</strong> Yes. Nolanville sits squarely in our Bell County
          service area between Temple and Killeen/Harker Heights.
        </p>
        <p>
          <strong>What projects are most common in Nolanville?</strong> Repairs, painting, roofing, fencing,
          kitchen/bath updates, and outdoor living packages are common—often stacked into one coordinated job.
        </p>
        <p>
          <strong>How do I get a quote?</strong> Call or text (254) 581-3808 or use the free quote form. We schedule
          a site visit when needed and provide a written proposal.
        </p>

        <p class="text-sm text-gray-600">
          Nearby:{' '}
          <a href="/services/general-contracting-harker-heights-tx" class="text-accent hover:underline">Harker Heights</a>
          {' · '}
          <a href="/services/general-contracting-killeen-tx" class="text-accent hover:underline">Killeen</a>
          {' · '}
          <a href="/services/general-contracting-temple-tx" class="text-accent hover:underline">Temple</a>
        </p>
      </div>

      <div class="bg-deep-blue text-white p-8 rounded-2xl">
        <h3 class="text-2xl font-semibold mb-4">Need a general contractor in Nolanville?</h3>
        <a href="/get-quote" class="inline-block bg-accent hover:bg-gold text-dark-blue font-bold px-8 py-3 rounded-lg">Get a Free Quote</a>
        <p class="mt-4 text-sm">Call or text: <a href="tel:2545813808" class="text-gold-primary">(254) 581-3808</a> · Mon–Fri 8:00 AM – 6:00 PM</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
