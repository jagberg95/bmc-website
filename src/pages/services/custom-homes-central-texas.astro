---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Custom Homes',
    name: 'Custom Homes in Central Texas',
    description:
      'Full custom home design and build with five generations of Central Texas craftsmanship, including roofing, painting, and energy-efficient construction.',
    provider: { '@type': 'GeneralContractor', name: 'Bar Moon Contracting', url: 'https://barmooncontracting.com/' },
    areaServed: 'Bell County, TX',
    url: 'https://barmooncontracting.com/services/custom-homes-central-texas',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://barmooncontracting.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://barmooncontracting.com/services' },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Custom Homes',
        item: 'https://barmooncontracting.com/services/custom-homes-central-texas',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long does a custom home take?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Typically 9–18 months from start to finish, depending on size, complexity, and material availability. We provide clear, realistic timelines upfront.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can you build on my lot?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. We evaluate soil, drainage, and access during planning.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do you offer design services?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'We work with your architect or can recommend trusted designers.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do you build energy-efficient homes?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. We incorporate insulation, windows, and systems to reduce long-term energy costs.',
        },
      },
    ],
  },
];
---

<Layout
  title="Custom Homes in Central Texas | Bar Moon Contracting"
  description="Custom home builders serving Temple, Belton, and Bell County—design-to-build, energy-efficient construction, and transparent budgeting from concept to keys."
  schemas={pageSchemas}
>
  <Header />
  
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="mb-8">
        <a href="/services" class="text-sm text-accent hover:underline">← Back to Services</a>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-4">Custom Homes in Central Texas</h1>
      <img src="/images/aubrey-odom-farmhouse-unsplash.jpg" alt="Farmhouse-style custom home built for Central Texas by Bar Moon Contracting" class="w-full aspect-[16/9] object-cover rounded-xl mb-6" width="800" height="450" loading="lazy" />
      <p class="text-xl text-gray-700 mb-10">Design and build your dream home with five generations of Central Texas craftsmanship. We handle everything—including roofing, painting, and finishes—from concept to keys with transparent budgeting and attention to detail.</p>

      <div class="prose max-w-none text-gray-700 mb-16 space-y-8">
        <h2 class="text-2xl md:text-3xl">What We Handle</h2>
        <ul>
          <li>Thoughtful design tailored to your lifestyle and the Texas climate</li>
          <li>High-quality materials and finishes that last</li>
          <li>Roofing, painting, and exterior finishes</li>
          <li>Energy-efficient construction practices</li>
          <li>Clear communication and realistic timelines</li>
          <li>Full coordination of all trades and inspections</li>
        </ul>

        <h2 class="text-2xl md:text-3xl">Local Considerations</h2>
        <p>We build with Bell County realities in mind: clay soils require proper foundations, high heat calls for good insulation and ventilation, and storm season means durable roofs and impact-resistant features. Our homes are designed to perform for generations.</p>

        <h2 class="text-2xl md:text-3xl">Our Process</h2>
        <ol>
          <li>Initial consultation and site evaluation</li>
          <li>Design collaboration and budgeting</li>
          <li>Permitting and pre-construction</li>
          <li>Building with regular updates and site access</li>
          <li>Final walkthrough, punch list, and warranty</li>
        </ol>

        <h2 class="text-2xl md:text-3xl">Frequently Asked Questions</h2>
        <p><strong>How long does a custom home take?</strong> Typically 9–18 months from start to finish, depending on size, complexity, and material availability. We provide clear, realistic timelines upfront.</p>
        <p><strong>Can you build on my lot?</strong> Yes. We evaluate soil, drainage, and access during planning.</p>
        <p><strong>Do you offer design services?</strong> We work with your architect or can recommend trusted designers.</p>
        <p><strong>Do you build energy-efficient homes?</strong> Yes. We incorporate insulation, windows, and systems to reduce long-term energy costs.</p>
      </div>

      <div class="bg-deep-blue text-white p-8 rounded-2xl">
        <h3 class="text-2xl font-semibold mb-4">Ready to build your dream home?</h3>
        <a href="/get-quote" class="inline-block bg-accent hover:bg-gold text-dark-blue font-bold px-8 py-3 rounded-lg">Start the Conversation</a>
        <p class="mt-4 text-sm">Call or text: <a href="tel:2545813808" class="text-gold-primary">(254) 581-3808</a> • Mon–Fri 8:00 AM – 6:00 PM</p>
      </div>
    </div>

  </main>

  <Footer />
</Layout>