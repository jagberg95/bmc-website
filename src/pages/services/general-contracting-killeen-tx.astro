---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const url = 'https://barmooncontracting.com/services/general-contracting-killeen-tx';
const city = 'Killeen, TX';
const title = 'General Contracting in Killeen, TX | Bar Moon Contracting';
const description =
  'Killeen general contractor for repairs, renovations, painting, roofing, and multi-trade projects—clear schedules for busy Fort Cavazos–area households.';

const pageSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'General Contracting',
    name: `General Contracting in ${city}`,
    description,
    provider: { '@type': 'GeneralContractor', name: 'Bar Moon Contracting', url: 'https://barmooncontracting.com/' },
    areaServed: [{ '@type': 'City', name: city }, { '@type': 'AdministrativeArea', name: 'Bell County, TX' }],
    url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://barmooncontracting.com/' },
      { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://barmooncontracting.com/services' },
      { '@type': 'ListItem', position: 3, name: `General Contracting in ${city}`, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Do you serve all of Killeen and nearby Fort Cavazos–area neighborhoods?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. We work across Killeen and coordinate projects that also touch Harker Heights and Nolanville when they fall in our service radius.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can you schedule around military and shift work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'We set clear decision points and phase updates so projects keep moving even when household schedules are irregular. Communication stays simple and documented.',
        },
      },
      {
        '@type': 'Question',
        name: 'Do you handle kitchen and bath remodels in Killeen too?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. See our dedicated kitchen and bath remodeling page for Killeen, or ask us to package remodel work with broader repairs and exterior projects.',
        },
      },
    ],
  },
];
---

<Layout title={title} description={description} schemas={pageSchemas}>
  <Header />
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-5xl mx-auto px-6 py-20">
      <div class="mb-8 text-sm text-gray-600">
        <a href="/services" class="text-accent hover:underline">Services</a>
        <span class="mx-2">/</span>
        <span>General Contracting in Killeen, TX</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-bold mb-6">General Contracting in Killeen, TX</h1>
      <p class="text-xl text-gray-700 mb-10">
        Killeen homes work hard. Between move cycles, shift schedules, and everyday family use, you need a general
        contractor who delivers durable repairs and renovations on a clear timeline—not vague promises. Bar Moon
        Contracting is the single point of contact for painting, roofing, remodels, outdoor work, and multi-trade
        coordination.
      </p>

      <div class="prose max-w-none text-gray-700 mb-16 space-y-8">
        <h2 class="text-2xl md:text-3xl">Contracting built for Killeen’s housing market</h2>
        <p>
          From older corridors near downtown and Rancier to denser residential areas that serve Fort Cavazos
          families, Killeen stock often needs practical upgrades: better kitchens and baths, roof and exterior
          maintenance, fencing that survives heat and wind, and repairs that do not require three vendors to
          finish one problem. High household use means materials and detailing matter as much as the finish photo.
        </p>
        <p>
          We write scopes that spell out what is included, what is not, and where allowances still need your
          selection. That keeps bids comparable and change orders from becoming a surprise lifestyle.
        </p>

        <h2 class="text-2xl md:text-3xl">What we handle in Killeen</h2>
        <ul>
          <li>General repairs and maintenance for occupied homes</li>
          <li>Renovations, including kitchen and bath packages</li>
          <li>Painting, roofing, and exterior finish systems</li>
          <li>Fencing, concrete, and outdoor living coordination</li>
          <li>Storm damage repair and insurance documentation support</li>
          <li>Electrical, plumbing, and HVAC coordination under one GC</li>
        </ul>

        <h2 class="text-2xl md:text-3xl">Local realities we plan around</h2>
        <p>
          <strong>Heat and UV.</strong> Exterior paint, fence materials, and roofing details must handle west Bell
          County sun—not mild-climate product choices.
        </p>
        <p>
          <strong>Clay soils and drainage.</strong> Slab edges, patio ties, and fence lines benefit from grading and
          water management that matches how the lot already behaves.
        </p>
        <p>
          <strong>Busy households.</strong> We protect pathways, contain dust on remodels, and keep schedules
          visible so you always know what phase comes next.
        </p>

        <h2 class="text-2xl md:text-3xl">Our process</h2>
        <ol>
          <li>Consultation and site assessment</li>
          <li>Written scope, pricing, and timeline</li>
          <li>Permits when required</li>
          <li>Supervised build with phase communication</li>
          <li>Walkthrough and closeout</li>
        </ol>

        <h2 class="text-2xl md:text-3xl">Killeen FAQs</h2>
        <p>
          <strong>Do you serve all of Killeen and nearby Fort Cavazos–area neighborhoods?</strong> Yes. We work
          across Killeen and coordinate projects that also touch Harker Heights and Nolanville when they fall in
          our service radius.
        </p>
        <p>
          <strong>Can you schedule around military and shift work?</strong> We set clear decision points and phase
          updates so projects keep moving even when household schedules are irregular. Communication stays simple
          and documented.
        </p>
        <p>
          <strong>Do you handle kitchen and bath remodels in Killeen too?</strong> Yes. See our dedicated
          <a href="/services/kitchen-bath-remodeling-killeen-tx">kitchen and bath remodeling page for Killeen</a>,
          or ask us to package remodel work with broader repairs and exterior projects.
        </p>

        <p class="text-sm text-gray-600">
          Nearby:{' '}
          <a href="/services/general-contracting-harker-heights-tx" class="text-accent hover:underline">Harker Heights</a>
          {' · '}
          <a href="/services/general-contracting-nolanville-tx" class="text-accent hover:underline">Nolanville</a>
          {' · '}
          <a href="/services/kitchen-bath-remodeling-killeen-tx" class="text-accent hover:underline">Killeen kitchen &amp; bath</a>
        </p>
      </div>

      <div class="bg-deep-blue text-white p-8 rounded-2xl">
        <h3 class="text-2xl font-semibold mb-4">Need a general contractor in Killeen?</h3>
        <a href="/get-quote" class="inline-block bg-accent hover:bg-gold text-dark-blue font-bold px-8 py-3 rounded-lg">Get a Free Quote</a>
        <p class="mt-4 text-sm">Call or text: <a href="tel:2545813808" class="text-gold-primary">(254) 581-3808</a> · Mon–Fri 8:00 AM – 6:00 PM</p>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
