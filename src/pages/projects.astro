---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Projects | Bar Moon Contracting">
  <Header />
  
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-6xl mx-auto px-6 py-16">
      <img src="/images/Projects/market-landscape-front-1.jpg" alt="Market prep landscaping and property preparation" class="w-full h-64 object-cover rounded-xl mb-8" width="1200" height="256" loading="lazy" />
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Our Projects</h1>
      <p class="text-xl text-gray-700 mb-10 max-w-3xl">
        Real work for real people across Central Texas. From custom homes and renovations to painting, septic systems, outdoor structures, and full property prep for market — we take pride in every build.
      </p>

      <!-- Painting Projects -->
      <div class="mb-16">
        <div class="mb-6">
          <p class="text-accent text-sm font-semibold tracking-widest">PAINTING</p>
          <h2 class="text-3xl font-bold">Exterior Painting Projects</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">Full exterior painting including complete house repaints, fence work, and accent doors. Clean, durable finishes built for Central Texas weather.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/Projects/painting-house.jpg" alt="Full exterior painting on a Central Texas home" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/painting-fence.jpg" alt="Freshly painted fence and exterior" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/painting-red-door.jpg" alt="Bright red door after painting project" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
        </div>
        <div class="mt-3">
          <a href="/services/home-renovations-temple-tx" class="text-gold-primary hover:underline text-sm">See more painting and renovations →</a>
        </div>
      </div>

      <!-- Septic System -->
      <div class="mb-16">
        <div class="mb-6">
          <p class="text-accent text-sm font-semibold tracking-widest">SEPTIC</p>
          <h2 class="text-3xl font-bold">Septic System Installation</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">New leach field and septic system installation. Proper excavation and code-compliant drainage solutions for residential properties.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/Projects/septic-excavator.jpg" alt="Excavator digging for new septic leach field" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/septic-farmhouse.jpg" alt="Farmhouse with new septic system installation" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
        </div>
        <div class="mt-3">
          <a href="/services/general-contracting-temple-tx" class="text-gold-primary hover:underline text-sm">See general contracting →</a>
        </div>
      </div>

      <!-- Patio Covering -->
      <div class="mb-16">
        <div class="mb-6">
          <p class="text-accent text-sm font-semibold tracking-widest">OUTDOOR STRUCTURES</p>
          <h2 class="text-3xl font-bold">Custom Patio Covering</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">New patio covering built for shade and extended outdoor living. Practical structure designed for Central Texas sun and weather.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/Projects/patio-covering-1.jpg" alt="Custom patio covering structure" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/patio-covering-2.jpg" alt="Completed patio covering project" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
        </div>
        <div class="mt-3">
          <a href="/services/outdoor-living-decks-patios-central-texas" class="text-gold-primary hover:underline text-sm">See outdoor living projects →</a>
        </div>
      </div>

      <!-- Pond Restoration -->
      <div class="mb-16">
        <div class="mb-6">
          <p class="text-accent text-sm font-semibold tracking-widest">WATER FEATURES</p>
          <h2 class="text-3xl font-bold">Pond Restoration</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">Complete pond restoration including banks, water feature, and surrounding area. Transformed into a clean, functional, and attractive landscape element.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/Projects/pond-restoration-1.jpg" alt="Pond restoration project - overview" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/pond-restoration-2.jpg" alt="Pond restoration in progress" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/pond-restoration-3.jpg" alt="Restored pond banks" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/pond-restoration-4.jpg" alt="Completed pond restoration" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/pond-restoration-5.jpg" alt="Pond restoration detail" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/pond-restoration-6.jpg" alt="Final pond restoration view" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
        </div>
        <div class="mt-3">
          <a href="/services/general-contracting-temple-tx" class="text-gold-primary hover:underline text-sm">See general contracting →</a>
        </div>
      </div>

      <!-- Market Property Prep -->
      <div class="mb-12">
        <div class="mb-6">
          <p class="text-accent text-sm font-semibold tracking-widest">MARKET PREP</p>
          <h2 class="text-3xl font-bold">Home Prepared for Market</h2>
          <p class="text-gray-600 mt-2 max-w-2xl">Full property preparation for sale: extensive front and back landscaping, concrete patio work, breezeway updates, and interior staging/renovations. Clean, move-in ready presentation.</p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          <img src="/images/Projects/market-landscape-front-1.jpg" alt="Front yard landscaping on home prepared for market" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-landscape-front-2.jpg" alt="Additional front landscaping view" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-landscape-back-1.jpg" alt="Back yard landscaping refresh" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-landscape-back-2.jpg" alt="Back landscaping detail" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-landscape-back-3.jpg" alt="Back yard after landscaping" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-landscape-back-4.jpg" alt="Final back landscaping view" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-concrete-patio.jpg" alt="New concrete patio as part of market prep" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-breezeway.jpg" alt="Breezeway area updated during market preparation" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-interior-kitchen.jpg" alt="Staged and renovated kitchen for market" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-interior-living.jpg" alt="Staged living area" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-interior-dining.jpg" alt="Staged dining space" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
          <img src="/images/Projects/market-interior-bathroom.jpg" alt="Updated bathroom staging" class="w-full aspect-[4/3] object-cover rounded-xl shadow" width="400" height="300" loading="lazy" />
        </div>
        <div class="mt-3">
          <a href="/services/home-renovations-temple-tx" class="text-gold-primary hover:underline text-sm">See renovations and market prep →</a>
        </div>
      </div>

      <div class="mt-12 text-center">
        <p class="text-gray-600 mb-4">Ready to start your own project?</p>
        <a href="/get-quote" class="inline-block bg-accent hover:bg-gold text-dark-blue font-bold px-10 py-4 rounded-lg text-lg">Request a Free Quote</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>