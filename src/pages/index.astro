---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Bar Moon Contracting | Central Texas General Contractor & Remodeler"
  description="Family-run general contractor serving Bell County, TX. Renovations, kitchen & bath remodels, custom homes, outdoor living, fencing, and repairs. Free quotes."
>
  <Header />

  <!-- Hero Section - original house image -->
  <section class="relative h-[100dvh] flex items-center justify-center overflow-hidden bg-dark-blue">
    <img 
      src="/images/herve-customhome-unsplash.jpg" 
      alt="Stunning custom home built by Bar Moon Contracting in Central Texas"
      class="absolute inset-0 w-full h-full object-cover"
      width="1920"
      height="1080"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-dark-blue/70 via-dark-blue/50 to-dark-blue/80"></div>
    
    <div class="relative z-10 text-center px-6 max-w-4xl">
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-4 tracking-tight">
        Central Texas Contracting Built on Craftsmanship, Clarity, and Integrity.
      </h1>
      <p class="text-xl md:text-2xl text-light-neutral/90 mb-8 max-w-2xl mx-auto">
        Bar Moon Contracting serves Bell County and the surrounding areas in Central Texas with renovations, painting, roofing, repairs, outdoor living, concrete, fencing, and custom construction.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/get-quote" class="bg-accent hover:bg-gold text-dark-blue font-bold px-8 py-4 rounded-lg text-lg transition">
          Request a Free Quote
        </a>
        <a href="tel:2545813808" class="border border-white/70 hover:bg-white/10 text-white font-bold px-8 py-4 rounded-lg text-lg transition">
          Call (254) 581-3808
        </a>
      </div>
    </div>
  </section>

  <!-- Services Mosaic - matching current look -->
  <section class="py-20 px-4 md:px-8 bg-gradient-to-b from-light-neutral to-[#d9d8d4]" id="services">
    <div class="max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-primary mb-4 uppercase tracking-widest">
        Our Services
      </h2>
      <p class="text-center text-gray-600 mb-12 max-w-2xl mx-auto">
        From quick fixes to full renovations and custom builds, we bring Texas craftsmanship, clear planning, and reliable project management to every project.
      </p>

      <div class="max-w-6xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 auto-rows-[260px] gap-5">
        <!-- Upgrades & Renovations - large tile (preserving original mosaic feel) -->
        <a href="/services/home-renovations-temple-tx" class="halo-hover group relative rounded-xl overflow-hidden sm:col-span-2 lg:col-span-2 sm:row-span-2 lg:row-span-2">
          <img src="/images/christian-mackie-kitchen2-unsplash.jpg" alt="Home renovations and kitchen updates by Bar Moon Contracting in Central Texas" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent group-hover:scale-105 transition-transform" />
          <div class="absolute inset-0 flex flex-col justify-end p-6">
            <p class="text-accent text-xs font-semibold uppercase tracking-widest mb-1">Transform Your Space, Elevate Your Life</p>
            <h3 class="text-2xl font-bold text-white mb-2">Upgrades &amp; Renovations</h3>
            <ul class="text-gray-300 text-sm space-y-1 mb-2">
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent" />Kitchens &amp; Baths</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent" />Whole Home</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent" />Flooring &amp; Layouts</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent" />Painting</li>
              <li class="flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-accent" />Roofing</li>
            </ul>
            <span class="mt-2 inline-block self-start bg-accent/90 text-primary font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-lg">See Renovation Details →</span>
          </div>
        </a>

        <!-- Home Repairs -->
        <a href="/services/fencing-concrete-repairs-central-texas" class="halo-hover group relative rounded-xl overflow-hidden">
          <img src="/images/sasun-bughdaryan-handyman-unsplash.jpg" alt="Home repairs and general contracting work in Temple, TX" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent group-hover:scale-105 transition-transform" />
          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <h3 class="text-xl font-bold text-white mb-1">Home Repairs</h3>
            <span class="text-accent text-xs">Quick fixes, repairs, leaks, etc.</span>
          </div>
        </a>

        <!-- Outdoor Living -->
        <a href="/services/outdoor-living-decks-patios-central-texas" class="halo-hover group relative rounded-xl overflow-hidden">
          <img src="/images/point3d-commercial-imaging-ltd-patio-unsplash.jpg" alt="Outdoor living patio and deck built for Central Texas" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent group-hover:scale-105 transition-transform" />
          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <h3 class="text-xl font-bold text-white mb-1">Outdoor Living</h3>
            <span class="text-accent text-xs">Decks • Patios • Hardscapes • Fencing &amp; Concrete Repairs</span>
          </div>
        </a>

        <!-- Custom Homes -->
        <a href="/services/custom-homes-central-texas" class="halo-hover group relative rounded-xl overflow-hidden col-span-1 sm:col-span-2 lg:col-span-2">
          <img src="/images/aubrey-odom-farmhouse-unsplash.jpg" alt="Custom home construction in Bell County, TX by Bar Moon Contracting" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent group-hover:scale-105 transition-transform" />
          <div class="absolute inset-0 flex flex-col justify-end p-5">
            <h3 class="text-2xl font-bold text-white mb-1">Custom Homes</h3>
            <p class="text-white/80 text-sm">Five generations of craftsmanship from the ground up.</p>
          </div>
        </a>
      </div>

      <div class="text-center mt-8">
        <a href="/services" class="text-accent hover:text-gold-primary font-medium">View All Services →</a>
      </div>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center text-primary mb-10">Our Featured Work</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="halo-hover bg-white p-4 rounded-xl">
          <img src="/images/Projects/painting-fence.jpg" alt="Freshly painted fence project by Bar Moon Contracting in Bell County, TX" class="rounded-xl w-full aspect-[4/3] object-cover mb-4" width="400" height="300" loading="lazy" />
          <h3 class="font-semibold">Painting Project – Fence &amp; Exterior</h3>
          <p class="text-sm text-gray-600 mb-4">Fresh paint on fence and home exterior for a clean, updated look.</p>
          <a href="/projects" class="inline-block bg-dark-blue text-white hover:bg-primary font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-lg transition">View Project</a>
        </div>
        <div class="halo-hover bg-white p-4 rounded-xl">
          <img src="/images/Projects/pond-restoration-5.jpg" alt="Restored pond full of water after Bar Moon Contracting restoration work" class="rounded-xl w-full aspect-[4/3] object-cover mb-4" width="400" height="300" loading="lazy" />
          <h3 class="font-semibold">Pond Restoration</h3>
          <p class="text-sm text-gray-600 mb-4">Complete pond restoration including banks and water feature work.</p>
          <a href="/projects" class="inline-block bg-dark-blue text-white hover:bg-primary font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-lg transition">View Project</a>
        </div>
        <div class="halo-hover bg-white p-4 rounded-xl">
          <img src="/images/Projects/patio-covering-2.jpg" alt="Custom patio covering built by Bar Moon Contracting in Central Texas" class="rounded-xl w-full aspect-[4/3] object-cover mb-4" width="400" height="300" loading="lazy" />
          <h3 class="font-semibold">Patio Covering Project</h3>
          <p class="text-sm text-gray-600 mb-4">New patio covering built for shade and extended outdoor living.</p>
          <a href="/projects" class="inline-block bg-dark-blue text-white hover:bg-primary font-bold text-xs uppercase tracking-wider py-2 px-4 rounded-lg transition">View Project</a>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/projects" class="text-accent hover:text-gold-primary font-medium">See More Projects →</a>
      </div>
    </div>
  </section>

  <!-- Trust & Why Us -->
  <section class="py-16 px-6 bg-dark-blue text-light-neutral">
    <div class="max-w-5xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Five Generations of Central Texas Craftsmanship</h2>
      <p class="max-w-2xl mx-auto mb-8 text-light-neutral/80">
        We show up, communicate clearly, and do the work right. Clear scope. Honest communication. Craftsmanship built to last.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/get-quote" class="bg-accent hover:bg-gold text-dark-blue font-bold px-8 py-3 rounded-lg">Request a Quote</a>
        <a href="/about" class="border border-white/50 hover:bg-white/10 px-8 py-3 rounded-lg transition">Learn Our Story</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>