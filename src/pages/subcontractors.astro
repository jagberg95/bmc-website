---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Subcontractors | Bar Moon Contracting">
  <Header />
  
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Subcontractor Partnerships</h1>
      <p class="text-xl text-gray-700 mb-8">We work with skilled, reliable local tradespeople who share our commitment to quality and professionalism.</p>

      <div class="prose text-gray-700">
        <p>If you’re a licensed subcontractor in Central Texas interested in partnering with Bar Moon Contracting, we’d like to hear from you.</p>
        <p>We value clear communication, on-time performance, and work that meets our high standards.</p>
      </div>

      <div class="mt-12">
        <a href="/contact" class="bg-accent text-dark-blue font-bold px-8 py-3 rounded-lg inline-block">Contact Us About Partnerships</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>