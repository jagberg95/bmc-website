---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service | Bar Moon Contracting">
  <Header />
  
  <main class="pt-20 bg-light-neutral text-primary">
    <div class="max-w-4xl mx-auto px-6 py-16 prose">
      <h1>Terms of Service</h1>
      <p>These terms govern your use of the Bar Moon Contracting website. By accessing the site, you agree to these terms.</p>

      <h2>Services</h2>
      <p>All estimates and proposals are subject to site inspection and final agreement. Work is performed according to the scope defined in your contract.</p>

      <h2>Payments</h2>
      <p>Payment schedules are outlined in your contract. Deposits are required to schedule work.</p>

      <h2>Warranties</h2>
      <p>We provide a one-year workmanship warranty on all projects, in addition to manufacturer warranties on materials.</p>

      <h2>Contact</h2>
      <p>For questions about these terms, please <a href="/contact">contact us</a>.</p>
    </div>
  </main>

  <Footer />
</Layout>