---
const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services' },
  { name: 'About', href: '/about' },
  { name: 'Projects', href: '/projects' },
  { name: 'FAQ', href: '/faq' },
  { name: 'Get Quote', href: '/get-quote' },
];

const serviceLinks = [
  { name: 'Home Renovations', href: '/services/home-renovations-temple-tx' },
  { name: 'Kitchen & Bath', href: '/services/kitchen-bath-remodeling-temple-tx' },
  { name: 'Outdoor Living', href: '/services/outdoor-living-decks-patios-central-texas' },
  { name: 'Custom Homes', href: '/services/custom-homes-central-texas' },
  { name: 'General Contracting', href: '/services/general-contracting-temple-tx' },
];

const faqLinks = [
  { name: 'General Contracting', href: '/faq#general-contracting' },
  { name: 'Home Renovations', href: '/faq#home-renovations' },
  { name: 'Kitchen & Bath Remodeling', href: '/faq#kitchen-bath' },
  { name: 'Outdoor Living', href: '/faq#outdoor-living' },
  { name: 'Fencing, Concrete & Repairs', href: '/faq#fencing-repairs' },
  { name: 'Custom Homes', href: '/faq#custom-homes' },
  { name: 'Blog', href: '/blog' },
];
---

<header 
  class="fixed top-0 left-0 w-full z-50 bg-[#101d43] bg-opacity-95 backdrop-blur-sm border-b border-white/10 transition-all duration-300"
  id="header"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between px-4 md:px-6 py-3">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 flex-shrink-0">
      <img 
        src="/images/Icon/BMC_Icon_DkGold.png" 
        alt="Bar Moon Contracting Logo" 
        class="w-8 h-8 object-contain"
      />
      <span class="text-sm md:text-base lg:text-lg font-bold tracking-wider text-gold-primary whitespace-nowrap">
        BAR MOON CONTRACTING
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm xl:text-base">
      {navLinks.map(link => link.name === 'Services' ? (
        <div class="relative group">
          <a href={link.href} class="text-white font-medium hover:text-gold-primary transition-colors">
            {link.name} <span class="text-xs">▾</span>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all">
            <div class="bg-[#101d43] border border-white/10 rounded-lg shadow-2xl py-2 min-w-[220px]">
              {serviceLinks.map(s => (
                <a href={s.href} class="block px-5 py-2.5 text-sm text-white hover:bg-deep-blue hover:text-gold-primary transition-colors">
                  {s.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : link.name === 'FAQ' ? (
        <div class="relative group">
          <a href={link.href} class="text-white font-medium hover:text-gold-primary transition-colors">
            {link.name} <span class="text-xs">▾</span>
          </a>
          <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 group-hover:opacity-100 pointer-events-none group-hover:pointer-events-auto transition-all">
            <div class="bg-[#101d43] border border-white/10 rounded-lg shadow-2xl py-2 min-w-[220px]">
              {faqLinks.map(f => (
                <a href={f.href} class="block px-5 py-2.5 text-sm text-white hover:bg-deep-blue hover:text-gold-primary transition-colors">
                  {f.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={link.href} class="text-white font-medium hover:text-gold-primary transition-colors whitespace-nowrap">
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Mobile Menu Button -->
    <button 
      id="mobile-menu-btn"
      class="lg:hidden text-white text-3xl w-11 h-11 flex items-center justify-center"
      aria-label="Toggle menu"
    >
      ☰
    </button>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-[#101d43] border-t border-gold-primary px-4 py-5">
    <nav class="flex flex-col gap-4 text-lg">
      {navLinks.map(link => (
        <a href={link.href} class="text-white hover:text-gold-primary transition py-1 border-b border-white/10 pb-2">
          {link.name}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      btn.textContent = menu.classList.contains('hidden') ? '☰' : '✕';
    });
  }

  // Header auto hide on scroll (matching original feel)
  let lastScrollY = window.scrollY;
  const header = document.getElementById('header');

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if (header) {
      if (currentScrollY > lastScrollY && currentScrollY > 50) {
        header.style.transform = 'translateY(-100%)';
      } else {
        header.style.transform = 'translateY(0)';
      }
    }
    lastScrollY = currentScrollY;
  });
</script>